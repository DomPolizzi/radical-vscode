{
  "name": "radical-reborn",
  "displayName": "Radical Reborn",
  "description": "A maintained fork of Radical — retro-futuristic dark theme for VSCode and Zed.",
  "version": "0.1.0",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=18"
  },
  "bugs": {
    "url": "https://github.com/DomPolizzi/radical-reborn/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DomPolizzi/radical-reborn"
  },
  "icon": "assets/icon.png",
  "galleryBanner": {
    "color": "#141322",
    "theme": "dark"
  },
  "categories": [
    "Themes"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Radical Reborn",
        "uiTheme": "vs-dark",
        "path": "./dist/RadicalReborn.json"
      }
    ]
  },
  "scripts": {
    "build": "ts-node ./theme/vscode/build.ts",
    "format": "prettier --write *.md theme",
    "lint": "NODE_ENV=test eslint theme"
  },
  "devDependencies": {
    "@types/chroma-js": "2.1.4",
    "@types/node": "18.11.17",
    "@typescript-eslint/eslint-plugin": "5.47.0",
    "@typescript-eslint/parser": "5.47.0",
    "chroma-js": "2.4.2",
    "eslint": "8.30.0",
    "prettier": "2.8.1",
    "ts-node": "10.9.1",
    "typescript": "4.9.4"
  }
}
