{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Radical Reborn",
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowJs": true
  },
  "include": ["theme"],
  "exclude": ["node_modules", "dist"]
}
